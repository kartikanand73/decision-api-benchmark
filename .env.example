# Copy to .env and fill in. .env is git-ignored; never commit it.
# Same pattern for each provider: KEY, BASE URL, MODEL. With an OpenRouter key and base URL on all three,
# every provider gets the same request over the same route (the fairest comparison).

# --- TypeSafe Jev
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-1.13

# --- OpenAI Decisions (gpt-6-luna)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api
DECISIONS_MODEL=openai/gpt-6-luna-decisions

# --- Microsoft Decision-1
MSD_API_KEY=
MSD_BASE_URL=https://openrouter.ai/api
MSD_MODEL=microsoft/microsoft-decision-1

# --- Calling a vendor directly instead (key and base URL must match):
#   Jev:       TYPESAFE_BASE_URL=https://api.typesafe.ai      JEV_MODEL=jev-1.13          (TypeSafe key)
#   OpenAI:    OPENAI_BASE_URL=https://api.openai.com/v1      DECISIONS_MODEL=gpt-6-luna  (OpenAI key; OpenAI's own format)
#   Microsoft: MSD_BASE_URL=https://<resource>.services.ai.azure.com   MSD_MODEL=<deployment name>  (Foundry key)
#              Azure won't let you name the deployment "Microsoft-Decision-1".
# Shortcut: OPENROUTER_API_KEY=... alone also works for all three (used when a provider's own key is empty).

# --- List prices per million input tokens (output is free on all three)
JEV_PRICE_IN_PER_MTOK=0.042
DECISIONS_PRICE_IN_PER_MTOK=0.10
MSD_PRICE_IN_PER_MTOK=0.042
